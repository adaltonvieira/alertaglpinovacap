# Garante que arquivos que rodam DENTRO do container Linux (Docker) sempre
# usem quebra de linha Unix (LF), independente do sistema operacional de
# quem clona o repositorio.

crontab       text eol=lf
entrypoint.sh text eol=lf
*.sh          text eol=lf
Dockerfile    text eol=lf
*.php         text eol=lf
*.sql         text eol=lf
*.json        text eol=lf
*.md          text eol=lf
*.yml         text eol=lf
*.yaml        text eol=lf